# Copy this file to .env and fill in your own values. Never commit .env.
# The Go services read these variables at runtime.

# --- Databases -------------------------------------------------------------
# Each service owns its schema in the reference architecture. They can share
# one MySQL instance with separate databases or use separate servers.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=ambassador
DB_PASSWORD=change-me

# Each service connects to its own database. Set DB_DATABASE per process:
# users, admin, ambassador, or checkout.
DB_DATABASE=users

# Used only by the optional populate-* commands.
SOURCE_DB_DSN=ambassador:change-me@tcp(localhost:3306)/ambassador

# --- HTTP -----------------------------------------------------------------
# Every API process listens on 8000 by default (the container port). For local
# runs on one machine, use 8001 users, 8002 admin, 8003 ambassador, 8004 checkout.
PORT=8000

# --- Authentication -------------------------------------------------------
# Signing key for user JWTs. Use a long random value outside local development.
JWT_SECRET=change-me-to-a-long-random-string

# --- Redis ----------------------------------------------------------------
# Only the ambassador service uses Redis. Inside Compose the host is "redis".
REDIS_ADDR=localhost:6379

# --- Service discovery -----------------------------------------------------
USERS_MS=http://localhost:8001
CHECKOUT_URL=http://localhost:5000

# --- Kafka -----------------------------------------------------------------
# Local development can use PLAINTEXT. Managed Kafka usually needs SASL_SSL.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC=email_topic
# The email consumer reads BOOTSTRAP_SERVERS, SECURITY_PROTOCOL and SASL_*
# (without the KAFKA_ prefix). The Compose and Kubernetes files map them.

# --- Stripe ----------------------------------------------------------------
# Use a test key for local development. Never commit a real key.
STRIPE_KEY=sk_test_replace_me

# --- Email -----------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Local images (optional) ----------------------------------------------
# USERS_IMAGE=ambassador-users:local
# ADMIN_IMAGE=ambassador-admin:local
# AMBASSADOR_IMAGE=ambassador-ambassador:local
# CHECKOUT_IMAGE=ambassador-checkout:local
# EMAIL_IMAGE=ambassador-email:local
